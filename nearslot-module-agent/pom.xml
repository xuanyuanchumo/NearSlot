<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.nearslot</groupId><artifactId>nearslot</artifactId><version>${revision}</version></parent>
  <artifactId>nearslot-module-agent</artifactId><name>nearslot-module-agent</name><description>AI</description>
  <dependencies>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-common</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-framework</artifactId><version>${project.version}</version></dependency>
    <!-- ADR-023：Spring AI 2.0.1（成熟库优先，禁自研 LLM 调用层） -->
    <!-- optional：未配置 API Key 时不参与自动装配，避免启动失败。
         Phase 3 正式接入 LLM 时移除 optional 并配置 spring.ai.openai.* -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
      <optional>true</optional>
    </dependency>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>io.swagger.core.v3</groupId><artifactId>swagger-annotations-jakarta</artifactId><version>2.2.55</version></dependency>
    <dependency><groupId>org.springframework.data</groupId><artifactId>spring-data-redis</artifactId></dependency>
  </dependencies>
</project>
