<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.nearslot</groupId><artifactId>nearslot</artifactId><version>${revision}</version></parent>
  <artifactId>nearslot-app</artifactId><name>nearslot-app</name><description>装配启动</description>
  <dependencies>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-common</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-framework</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-module-auth</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-module-shop</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-module-appointment</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-module-order</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.nearslot</groupId><artifactId>nearslot-module-agent</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <!-- Actuator + Prometheus：application.yaml 已配置 management.endpoints 暴露，
         此前缺依赖导致 /actuator/* 全部 404（本轮修复） -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
    <dependency><groupId>com.baizhukui</groupId><artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId><version>${knife4j.version}</version></dependency>
    <!-- MyBatis-Plus 分页/防全表插件所在模块（3.5.9+ 从 extension 拆出，starter 不传递）。
         只在 app 引入：各业务模块只用 BaseMapper，不需要分页拦截器本身。 -->
    <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-jsqlparser</artifactId></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${spring-boot.version}</version>
      <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
    </plugin>
  </plugins></build>
</project>
