# NearSlot 环境变量模板（ADR-013：密钥全部走 .env，禁明文进 compose/镜像）
# 用法：cp .env.example .env 后填写真实值；.env 不入库。
# 本地开发端口（docker-compose.infra.yml）：MySQL 43306 / Redis 46379 / RabbitMQ 45672（控制台 45673）

# --- MySQL ---
MYSQL_DATABASE=nearslot
MYSQL_USER=nearslot
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_HOST=localhost

# --- Redis（Redisson 同一实例）---
REDIS_HOST=localhost
REDIS_PASSWORD=CHANGE_ME

# --- RabbitMQ（ADR-014）---
RABBITMQ_USER=nearslot
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_HOST=localhost

# --- AI（Spring AI + DashScope）---
DASHSCOPE_API_KEY=CHANGE_ME

# --- 观测（Langfuse，白名单 ADR-011）---
LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_SECRET_KEY=CHANGE_ME

# --- 应用 ---
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_LONG_SECRET
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL_MODULE=INFO
